# Create a dedicated bot with @BotFather and paste its token locally.
TELEGRAM_BOT_TOKEN=
# Run npm run identify and message your bot to find your numeric user ID.
TELEGRAM_ALLOWED_USER_ID=
CODEX_WORKDIR=.
CODEX_BIN=codex
CODEX_SANDBOX=workspace-write
# For autonomous Git commits and GitHub access, explicitly set both:
# CODEX_SANDBOX=danger-full-access
# CODEX_ALLOW_FULL_ACCESS=true
CODEX_ALLOW_FULL_ACCESS=false
# GitHub token for gh; fill locally, never send in chat.
GH_TOKEN=
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=1800
# Conversation dashboard on this Mac only.
DASHBOARD_PORT=8787
